# 离线地图：PowerShell 中通过 $env:MAP_DATA_DIR 指定外置资源根目录。
# 留空时依次查找仓库根目录 map-data/、仓库同级 map-data/；此项是服务器进程环境变量，不注入浏览器。
# 浏览器地图清单地址请修改 public/map-config.json，生产修改 dist/map-config.json。
MAP_DATA_DIR=

# 后端 API 根地址；留空时同源使用 /api，本地开发由 Vite 代理至 127.0.0.1:8080。
APP_PUBLIC_API_BASE_URL=

# 可选：仅覆盖 Vite 开发代理目标，不会注入浏览器。
APP_API_PROXY_TARGET=http://127.0.0.1:8080

# 以下历史高德配置已停用；保留占位，不读取或修改本机已有密钥。
VITE_AMAP_KEY=

# 已停用，不会注入浏览器或生产包。
VITE_AMAP_SECURITY_CODE=

# 已停用，当前地图不使用高德安全代理。
VITE_AMAP_SERVICE_HOST=
